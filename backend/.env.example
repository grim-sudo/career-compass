PORT=5000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:3000
# Select one provider: gemini (default), openai, or claude. Keys stay server-side.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
# Compose supplies DATABASE_URL. For native development, set a local connection:
# DATABASE_URL=postgresql://career:password@127.0.0.1:5432/career_compass
COOKIE_SECURE=false
