{
  "name": "career-compass",
  "version": "1.0.0",
  "description": "Career Compass - AI-powered career guidance platform",
  "scripts": {
    "setup:local": "node scripts/setup-local.cjs",
    "start:local": "docker compose up --build -d --wait",
    "stop:local": "docker compose down",
    "install-all": "npm ci --prefix backend --ignore-scripts --no-audit --no-fund && npm ci --prefix frontend --ignore-scripts --no-audit --no-fund",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "build": "cd frontend && npm run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/career-compass"
  },
  "keywords": [
    "career",
    "ai",
    "education",
    "guidance",
    "gemini"
  ],
  "author": "",
  "license": "MIT"
}
